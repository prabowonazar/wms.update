{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Public-safe workspace metadata for a signed-in warehouse operator.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the workspace owner."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "activeWarehouse": {
          "type": "string",
          "enum": ["Gudang Pusat", "Gudang Meruya", "Gudang Denpasar", "Gudang Surabaya"]
        },
        "activeOperatorId": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "displayName", "activeWarehouse", "createdAt", "updatedAt"]
    },
    "WarehouseOperatorDoc": {
      "title": "WarehouseOperatorDoc",
      "description": "Official warehouse staff operator profile and assigned branch warehouse.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nik": {
          "type": "string",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["operator", "admin", "supervisor"]
        },
        "assignedWarehouse": {
          "type": "string",
          "enum": ["Gudang Pusat", "Gudang Meruya", "Gudang Denpasar", "Gudang Surabaya"]
        },
        "warehouseLabel": {
          "type": "string",
          "maxLength": 64
        },
        "allowedWarehouses": {
          "type": "array",
          "description": "Explicit list of branch warehouses accessible by this operator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "id", "nik", "name", "role", "assignedWarehouse", "warehouseLabel", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
