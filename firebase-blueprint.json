  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Public-safe operator workspace preferences."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Isolated user PII (email, avatar URL)."
    },
    "/users/{userId}/inventory_items/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItemDoc" },
      "description": "Cloud-synced inventory stock updates and custom items."
    },
    "/users/{userId}/scan_logs/{logId}": {
      "schema": { "$ref": "#/entities/ScanLogDoc" },
      "description": "Barcode scan history logs."
    },
    "/users/{userId}/opname_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/OpnameSessionDoc" },
      "description": "Stock opname sessions."
    },
    "/users/{userId}/opname_sessions/{sessionId}/counts/{countId}": {
      "schema": { "$ref": "#/entities/OpnameCountDoc" },
      "description": "Individual item counts within an opname session."
    },
    "/users/{userId}/inbound_orders/{orderId}": {
      "schema": { "$ref": "#/entities/InboundOrderDoc" },
      "description": "Good Receipt (GR) inbound orders."
    },
    "/users/{userId}/outbound_orders/{orderId}": {
      "schema": { "$ref": "#/entities/OutboundOrderDoc" },
      "description": "Delivery Order (DO) outbound dispatches."
    },
    "/users/{userId}/stock_cards/{entryId}": {
      "schema": { "$ref": "#/entities/StockCardDoc" },
      "description": "Warehouse stock ledger entries."
    },
